{
  "name": "obgyn-registry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mac": "ulimit -n 10240 2>/dev/null; next dev -H 127.0.0.1 -p 3000",
    "dev:restart": "lsof -nP -iTCP:3000 -sTCP:LISTEN -t | xargs kill -9 2>/dev/null; ulimit -n 10240 2>/dev/null; next dev -H 127.0.0.1 -p 3000",
    "test": "vitest run && node --import tsx --test tests/*.test.ts",
    "test:db": "node scripts/test-db.mjs",
    "test:db:instruments": "node scripts/test-instruments-db.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "start:local": "next build && next start -H 127.0.0.1 -p 3020",
    "restart:local": "lsof -ti :3020 | xargs kill -9 2>/dev/null; npm run start:local",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint --ignore-pattern playwright-report --ignore-pattern test-results --ignore-pattern coverage",
    "db:push": "prisma db push",
    "db:backfill": "node scripts/backfill-tumour-v2.mjs",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "papaparse": "^5.5.4",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
